# URL de tu proyecto Supabase (se normaliza automáticamente)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Claves desde Supabase > Settings > API Keys (NO compartir la service role)
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Bucket de almacenamiento (por defecto "Faces")
SUPABASE_STORAGE_BUCKET=Faces

# Origen permitido para CORS (ajustar en producción)
FRONTEND_URL=http://localhost:8080

# Borra la asistencia del día al iniciar (0 = no)
RESET_ATTENDANCE_ON_STARTUP=0
